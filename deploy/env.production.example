# 生产环境配置模板
# 部署时复制为 backend/.env，然后填 API Key 与邮箱授权码：
#   cp deploy/env.production.example backend/.env
#   chmod 600 backend/.env          # 只有 learnmate 用户可读
# 改完必须重启：systemctl restart learnmate

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://xplt.sdu.edu.cn:4000
# 模型名必须与 Key 允许的模型完全一致。网关要求带厂商前缀；
# 直连 api.deepseek.com 时改成官方的名字。
DEEPSEEK_MODEL=ByteDance-volcengine/DeepSeek-V4.1-Flash
# 答疑实测 30~90s，留足余量（Nginx 侧 proxy_read_timeout 也需 >= 这个值）
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=20480

# ---------- 数据库 ----------
# 绝对路径，避免 systemd 的 WorkingDirectory 变化导致读写到别处
DATABASE_URL=sqlite:////opt/learnmate/backend/dev.db
# 将来换 MySQL 时：
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/learnmate?charset=utf8mb4

# ---------- 邮件（邮箱验证码登录）----------
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 填「授权码」，不是登录密码
SMTP_PASS=
MAIL_FROM_NAME=智能拍照学习助手

# ---------- 认证 ----------
AUTH_TOKEN_DAYS=30
# ⚠️ 公网部署必须设为 0：
#    演示账号（1001）的 is_demo=True 会放行任意 user_id 的数据读取，
#    开着等于留了个后门。只在汇报演示时临时开，用完立刻关掉并重启。
ALLOW_DEMO_LOGIN=0
