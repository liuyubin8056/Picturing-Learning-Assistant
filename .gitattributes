# ============================================================
# 换行符策略：仓库统一以 LF 存储，工作区也统一 LF
#
# 背景：Windows 下 core.autocrlf=true 会在检出时把 LF 转成 CRLF，
#       导致 git add 反复提示 "LF will be replaced by CRLF"。
#       本文件优先级高于 core.autocrlf，显式声明后警告消除，
#       且保证跨平台（Windows 开发 / Linux 部署）行为一致。
# ============================================================

# 默认：自动识别文本文件，统一 LF
* text=auto eol=lf

# ---------- 源代码与配置：强制 LF ----------
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# ---------- Windows 专用脚本：保留 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- 二进制文件：禁止任何换行转换 ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.db    binary
*.sqlite binary
*.pyc   binary
*.onnx  binary
*.woff  binary
*.woff2 binary
