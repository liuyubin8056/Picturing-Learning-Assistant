# ============================================================
# 智能拍照学习助手 · 后端环境配置
# 复制本文件为 .env 并填入真实值
# ============================================================

# ---------- DeepSeek 多模态大模型 ----------
# ↓↓↓ 在等号后面填入你的 DeepSeek API Key ↓↓↓
DEEPSEEK_API_KEY=
# OpenAI 兼容协议地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称
DEEPSEEK_MODEL=Deepseek-V4.1-Flash
# 调用超时（秒）
DEEPSEEK_TIMEOUT=60
# 单次响应 token 上限（推理型模型的思考 token 也计入，偏小会导致正文为空）
# 实测高数题思考常达 12000+ token，建议 32000
DEEPSEEK_MAX_TOKENS=32000

# ---------- 数据库 ----------
# 开发默认 SQLite（零依赖）；切换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/photo_tutor?charset=utf8mb4
DATABASE_URL=sqlite:///./dev.db

# ---------- 文件存储 ----------
# 本地存储目录（MVP 方案；二期换 OSS 时实现 StorageBackend 新驱动即可）
UPLOAD_DIR=./uploads

# ---------- 邮件（邮箱验证码登录） ----------
# console：验证码打后端日志 + 接口回显（本地开发，不联网）
# smtp   ：真实发信（QQ/163 邮箱 → 设置 → 账户 → 开启 SMTP → 生成授权码）
MAIL_PROVIDER=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：填邮箱的「授权码」，不是登录密码
SMTP_PASS=
MAIL_FROM_NAME=智能拍照学习助手

# ---------- 认证 ----------
# 登录令牌有效期（天）
AUTH_TOKEN_DAYS=30
# 演示账号（1001）免登录入口；正式对外时请关闭
ALLOW_DEMO_LOGIN=1
